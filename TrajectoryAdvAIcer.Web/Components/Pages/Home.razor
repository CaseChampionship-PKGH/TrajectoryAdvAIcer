@page "/"
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveServer
@using TrajectoryAdvAIcer.Api.Models
@using System.Text.Json
@using System.Text

<PageTitle>TrajectoryAdvAIcer – Рекомендации обучения</PageTitle>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="display-5 mb-3">Рекомендации траекторий обучения</h1>
            <p class="lead text-muted">Загрузите историю обучения и справочник курсов, чтобы получить персонализированные траектории.</p>

            <div class="card mb-4 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3">Исходные данные</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                История обучения <span class="text-danger">*</span>
                            </label>
                            <InputFile OnChange="HandleHistoryFile" class="form-control" accept=".xlsx,.csv,.zip,.json" />
                            @if (historyFile != null)
                            {
                                <small class="text-success mt-1 d-block">@historyFile.Name</small>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                Справочник курсов <span class="text-danger">*</span>
                            </label>
							<InputFile OnChange="HandleCatalogFile" class="form-control" accept=".xlsx,.csv,.zip,.json" />
                            @if (catalogFile != null)
                            {
                                <small class="text-success mt-1 d-block">@catalogFile.Name</small>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Вариант ИИ-агента</label>
                        <select @bind="selectedVariant" class="form-select">
                            <option value="russian">Российские нейросети</option>
                            <option value="foreign">Зарубежные нейросети</option>
                            <option value="local">Локальная модель</option>
                        </select>
                    </div>

                    <button class="btn btn-lg w-100" style="background-color: #33B47C; color: white;" @onclick="StartAnalysis" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Анализируем...</span>
                        }
                        else
                        {
                            <span>Запустить анализ</span>
                        }
                    </button>

					@if (showCsvWarning)
					{
						<div class="alert alert-warning" role="alert">
							⚠️ Вы загрузили два CSV-файла. Из-за особенностей браузерной передачи возможна нестабильная работа.
							Рекомендуем пересохранить файлы в формате Excel (.xlsx) для надёжности.
						</div>
					}
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border" style="width: 3rem; height: 3rem; color: #33B47C;" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                    <p class="mt-3 text-muted">Идёт анализ... Пожалуйста, подождите.</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <span>@errorMessage</span>
                    <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

			@if (warnings != null && warnings.Count > 0)
			{
				<div class="alert alert-warning" style="max-height: 200px; overflow-y: auto;">
					<ul class="mb-0">
						@foreach (var warning in warnings)
						{
							<li>@warning</li>
						}
					</ul>
					<button type="button" class="btn-close position-absolute top-0 end-0 m-2" @onclick="() => warnings.Clear()"></button>
				</div>
			}

            @if (analysisResult != null && analysisResult.TrajectoryAdvices.Count > 0)
            {
                <div class="card mt-4 shadow-sm">
                    <div class="card-header text-white" style="background-color: #33B47C;">
                        <h5 class="mb-0">Результаты анализа</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <button class="btn btn-outline-secondary" @onclick="PreviousEmployee" disabled="@(currentEmployeeIndex == 0)">
                                ← Предыдущий сотрудник
                            </button>
                            <span class="fw-bold">@(currentEmployeeIndex + 1) / @analysisResult.TrajectoryAdvices.Count</span>
                            <button class="btn btn-outline-secondary" @onclick="NextEmployee" disabled="@(currentEmployeeIndex >= analysisResult.TrajectoryAdvices.Count - 1)">
                                Следующий сотрудник →
                            </button>
                        </div>

                        @{
                            var emp = analysisResult.TrajectoryAdvices[currentEmployeeIndex];
                        }

                        <div class="card border-success">
                            <div class="card-body">
                                <h4 class="card-title">@emp.Profile.FullName</h4>
                                <h6 class="card-subtitle mb-3 text-muted">@emp.Profile.Position</h6>
                                <p class="card-text"><strong>ИОГВ:</strong> @emp.Profile.IOGV</p>

								<h6>Пройденные курсы</h6>
								@if (emp.PassedCourseNames != null && emp.PassedCourseNames.Count > 0)
								{
									<ul class="list-group list-group-flush mb-4">
										@foreach (var course in emp.PassedCourseNames)
										{
											<li class="list-group-item">@course</li>
										}
									</ul>
								}
								else
								{
									<p class="text-muted">Нет пройденных курсов.</p>
								}

								<h6>Рекомендованная траектория</h6>
								@if (emp.Trajectory != null && emp.Trajectory.Count > 0)
								{
									<div class="list-group">
										@foreach (var rec in emp.Trajectory)
										{
											<div class="list-group-item list-group-item-action">
												<div class="d-flex w-100 justify-content-between">
													<h6 class="mb-1">@rec.CourseTitle</h6>
												</div>
												<p class="mb-1">@rec.Rationale</p>
											</div>
										}
									</div>
								}
								else
								{
									<p class="text-muted">Рекомендации не сформированы.</p>
								}
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-3">
                        <button class="btn btn-success" @onclick="DownloadExcel">
                            Скачать Excel
                        </button>
                        <button class="btn btn-outline-success" @onclick="DownloadJson">
                            Скачать JSON
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IBrowserFile? historyFile;
    private IBrowserFile? catalogFile;
    private string selectedVariant = "foreign";
    private bool isLoading;
    private string? errorMessage;
    private List<string>? warnings;
    private AnalysisResultApiModel? analysisResult;
    private string? reportDataJson;
    private int currentEmployeeIndex = 0;

    private void HandleHistoryFile(InputFileChangeEventArgs e) => historyFile = e.File;
    private void HandleCatalogFile(InputFileChangeEventArgs e) => catalogFile = e.File;

	private bool showCsvWarning =>
		historyFile != null &&
		catalogFile != null &&
		Path.GetExtension(historyFile.Name).Equals(".csv", StringComparison.OrdinalIgnoreCase) &&
		Path.GetExtension(catalogFile.Name).Equals(".csv", StringComparison.OrdinalIgnoreCase);

    private void PreviousEmployee()
    {
        if (currentEmployeeIndex > 0) currentEmployeeIndex--;
    }

    private void NextEmployee()
    {
        if (analysisResult != null && currentEmployeeIndex < analysisResult.TrajectoryAdvices.Count - 1)
            currentEmployeeIndex++;
    }

    private async Task StartAnalysis()
    {
        if (historyFile == null || catalogFile == null)
        {
            errorMessage = "Необходимо загрузить оба файла.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        analysisResult = null;
        warnings = null;
        currentEmployeeIndex = 0;
        StateHasChanged();

        try
        {
            using var formData = new MultipartFormDataContent();

            var historyContent = new StreamContent(historyFile.OpenReadStream(maxAllowedSize: 100_000_000));
            historyContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(historyFile.ContentType ?? "application/octet-stream");
            formData.Add(historyContent, "learningHistory", historyFile.Name);

            var catalogContent = new StreamContent(catalogFile.OpenReadStream(maxAllowedSize: 100_000_000));
            catalogContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(catalogFile.ContentType ?? "application/octet-stream");
            formData.Add(catalogContent, "courseCatalog", catalogFile.Name);

            var variant = selectedVariant switch
            {
                "russian" => "RussianAiAgent",
				"foreign" => "ForeignAiAgent",
				"local" => "LocalAiAgent",
				_ => "RussianAiAgent"
            };

			var requestUri = $"api/analysis/run?analysisMethod={variant}";
			var response = await Http.PostAsync(requestUri, formData);

            if (response.IsSuccessStatusCode)
            {
                reportDataJson = await response.Content.ReadAsStringAsync();
                analysisResult = JsonSerializer.Deserialize<AnalysisResultApiModel>(
                    reportDataJson,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true,
                        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
                    });
                warnings = analysisResult?.Errors;
            }
            else
            {
                var errorJson = await response.Content.ReadAsStringAsync();
                errorMessage = $"Ошибка сервера: {response.StatusCode}. {errorJson}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка подключения: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadExcel()
    {
        if (analysisResult == null) return;
        var response = await Http.PostAsJsonAsync("api/analysis/export/excel", analysisResult);
        if (response.IsSuccessStatusCode)
        {
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var fileName = "Рекомендации_траекторий.xlsx";
            if (response.Headers.TryGetValues("X-Filename", out var values))
            {
                var encoded = values.FirstOrDefault();
                if (!string.IsNullOrEmpty(encoded))
                    fileName = Uri.UnescapeDataString(encoded);
            }
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", streamRef, fileName);
        }
        else
        {
            errorMessage = "Не удалось скачать Excel-отчёт.";
        }
    }

    private async Task DownloadJson()
    {
        if (reportDataJson == null) return;
        byte[] bytes = Encoding.UTF8.GetBytes(reportDataJson);
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", streamRef, "trajectories.json");
    }
}
